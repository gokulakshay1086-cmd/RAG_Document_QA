# ---- LLM Provider ----
# Get a key from https://platform.openai.com/api-keys
# If left empty, the system automatically falls back to a free, local
# extractive answering mode (no external API calls, works fully offline).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Embeddings ----
# Any sentence-transformers model works. This one is small, fast, and free.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Chunking ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---- Retrieval ----
TOP_K=4

# Hybrid search blends semantic (embedding) search with BM25 keyword search.
# Helps a lot with exact terms like names, dates, and codes that pure
# embedding search can miss.
USE_HYBRID_SEARCH=true
HYBRID_ALPHA=0.5           # 1.0 = pure semantic, 0.0 = pure keyword

# Cross-encoder re-ranking: pulls a wider candidate pool, then re-scores it
# with a slower-but-more-accurate model before picking the final TOP_K.
USE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CANDIDATE_K=20

# ---- Storage ----
VECTOR_STORE_DIR=./data/vectorstore
UPLOAD_DIR=./data/uploads
