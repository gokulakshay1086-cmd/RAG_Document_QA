# ---- LLM Provider ----
# Get a key from https://platform.openai.com/api-keys
# If left empty, the system automatically falls back to a free, local
# extractive answering mode (no external API calls, works fully offline).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Embeddings ----
# Any sentence-transformers model works. This one is small, fast, and free.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Chunking ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---- Retrieval ----
TOP_K=4

# ---- Storage ----
VECTOR_STORE_DIR=./data/vectorstore
UPLOAD_DIR=./data/uploads
